# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMTP Configuration for sending email notifications on form submission
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-or-smtp-password"
SMTP_FROM="Edunura Enrollment <noreply@edunura.com>"
ADMIN_EMAIL="vidhathrisharma.d@gmail.com"

